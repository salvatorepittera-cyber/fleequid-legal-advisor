 },
 {
  "it": "reclamo disciplinato dall’articolo 13 delle Condizioni Generali",
  "tr": "die in Artikel 13 der Allgemeinen Geschäftsbedingungen geregelte Reklamation",
  "source": "Fleequid Care v2 (nuovo)",
  "why": "AGB DE Art. 13 „REKLAMATIONEN“; termine Reklamation già in glossario."
 },
 {
  "it": "chilometraggio iniziale",
  "tr": "Anfangskilometerstand",
  "source": "Fleequid Care v2 (nuovo)",
  "why": "Scelta mia: composto da „Kilometerstand“ (= chilometraggio in BGBFC 7.3 e AGB DE)."
 },
 {
  "it": "contachilometri",
  "tr": "Kilometerzähler",
  "source": "Fleequid Care v2 (nuovo)",
  "why": "Già in BGBFC v1 DE Art. 6.8."
 },
 {
  "it": "percorrenza",
  "tr": "Laufleistung",
  "source": "Fleequid Care v2 (nuovo)",
  "why": "Scelta mia: termine tecnico standard per i km percorsi; distinto da „Kilometerstand“ (= chilometraggio). Nota: le AGB DE rendono „percorrenza chilometrica“ con „Kilometerstand“. Revisione: in c09 la percorrenza „risultante“ è resa con „sich ergebende“ (non „angezeigte“, che presuppone un contachilometri funzionante)."
 },
 {
  "it": "limite temporale / limite chilometrico",
  "tr": "zeitliche Grenze / Kilometergrenze",
  "source": "Fleequid Care v2 (nuovo)",
  "why": "Scelta mia, coerente con „Grenze“ usato nel documento."
 },
 {
  "it": "prova primaria",
  "tr": "vorrangiger Nachweis",
  "source": "Fleequid Care v2 (nuovo)",
  "why": "Scelta mia; „Nachweis“ come in AGB DE („dokumentarische/fotografische Nachweise“)."
 },
 {
  "it": "evidenza documentale o fotografica",
  "tr": "dokumentarische oder fotografische Nachweise",
  "source": "Fleequid Care v2 (nuovo)",
  "why": "AGB DE („dokumentarische Nachweise“, „fotografischen Nachweise“)."
 },
 {
  "it": "arbitro unico",
  "tr": "Einzelschiedsrichter",
  "source": "Fleequid Care v2 (nuovo)",
  "why": "Già in BGBFC v1 DE Art. 12.4."
 },
 {
  "it": "titolo (quanto a titolo e contenuto)",
